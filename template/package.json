{
  "name": "bilinc-cloudflare-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.0",
    "@cloudflare/computer": "^0.10.0",
    "@cloudflare/think": "^0.24.0",
    "agents": "^0.34.0",
    "ai": "^7.0.0",
    "bilinc-cloudflare-agents": "file:../bilinc-cloudflare-agents-0.1.0.tgz",
    "just-bash": "^3.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.0",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "cloudflare": {
    "bindings": {
      "BILINC_API_KEY": {
        "description": "Your Bilinc API key. Bilinc is free forever with no card and 2,000 credits a month. Create a dedicated Bilinc account for this agent, never your main one: https://bilinc.space/signup?next=/api-keys&utm_source=cloudflare&utm_medium=deploy&utm_campaign=bilinc-cloudflare-agents"
      },
      "APP_ACCESS_TOKEN": {
        "description": "A passphrase you choose, at least 16 characters. Anyone who knows it can use this agent and its Bilinc key."
      }
    }
  }
}
