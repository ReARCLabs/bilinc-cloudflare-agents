{
  "name": "bilinc-cloudflare-agent-test",
  "main": "helpers/test-agent.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "BilincAgent", "class_name": "TestAgent" },
      { "name": "UNLOCK_LIMITER", "class_name": "UnlockLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestAgent", "UnlockLimiter"] }],
  "vars": {
    "MODEL": "@cf/openai/gpt-oss-120b",
    "MODELS": [
      { "id": "@cf/openai/gpt-oss-120b", "label": "gpt-oss-120b", "note": "Default. Reliable with memory tools", "tag": "to test", "effort": ["low", "medium", "high"] },
      { "id": "@cf/openai/gpt-oss-20b", "label": "gpt-oss-20b", "note": "Smaller and faster", "tag": "to test", "effort": ["low", "medium", "high"] },
      { "id": "@cf/meta/llama-4-scout-17b-16e-instruct", "label": "llama-4-scout", "note": "Fast; no reasoning control", "tag": "to test", "effort": null }
    ],
    "BILINC_NAMESPACE": "default",
    "AUTO_CHECKPOINT": "false",
    "BILINC_API_KEY": "bil_live_test_key",
    "APP_ACCESS_TOKEN": "correct-horse-battery-staple"
  }
}
